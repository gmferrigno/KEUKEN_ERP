APP_PORT=
PORT=
NEXT_PUBLIC_API_URL=
PUBLIC_API_URL=
# Brand: DEFAULT, KEUKEN, MDLZ
# Prefer NEXT_PUBLIC_BRAND for client bundle; APP_BRAND kept as alias.
APP_BRAND=
NEXT_PUBLIC_BRAND=
# Theme sheet: DEFAULT, MDLZ, MAP, etc. (defaults to brand theme if omitted)
# Prefer NEXT_PUBLIC_THEME_SHEET for client bundle; THEME_SHEET kept as alias.
THEME_SHEET=
NEXT_PUBLIC_THEME_SHEET=
# Deploy environment override (optional, defaults based on PORT)
# Prefer NEXT_PUBLIC_DEPLOY_ENV for client bundle; DEPLOY_ENV kept as server alias.
DEPLOY_ENV=
NEXT_PUBLIC_DEPLOY_ENV=

# Cookie Secure flag (runtime). Controls authToken/permissions/companyLicense.
# true  → force Secure (requires HTTPS; use in production final)
# false → allow cookies over HTTP (preprod/staging without TLS)
# omit  → infer from x-forwarded-proto; if absent, defaults to false
COOKIE_SECURE=

NEXT_PUBLIC_APP_VERSION="v1.0.0"
PUBLIC_APP_VERSION="v1.0.0"

# Soporte para recuperación de cuenta sin medios de contacto
PUBLIC_SUPPORT_CONTACT_NUMBER=
NEXT_PUBLIC_SUPPORT_CONTACT_NUMBER=